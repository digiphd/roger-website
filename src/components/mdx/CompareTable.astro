---
/**
 * Comparison block — supports two modes:
 * 1. left/right props: two-column before/after, pros/cons, do/don't
 * 2. headers/rows props: generic data table with header row
 */
interface CompareItem {
  title: string;
  items: string[];
}

interface Props {
  left?: CompareItem;
  right?: CompareItem;
  headers?: string[];
  rows?: string[][];
  leftColor?: string;
  rightColor?: string;
}

const {
  left,
  right,
  headers,
  rows,
  leftColor = "text-red-400",
  rightColor = "text-emerald-400",
} = Astro.props;

const isTableMode = !!headers && !!rows;
---

{isTableMode ? (
  <div class="my-8 not-prose">
    <div class="overflow-x-auto rounded-lg border border-[var(--color-border)] bg-[var(--color-surface-raised)]">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-[var(--color-border)]">
            {headers.map((h) => (
              <th class="px-4 py-3 text-left font-semibold text-[var(--color-text)]">{h}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row, i) => (
            <tr class="border-b border-[var(--color-border)] last:border-b-0">
              {row.map((cell, j) => (
                <td class="px-4 py-3 text-[var(--color-text-secondary)]">{cell}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
) : (
  <div class="my-8 grid grid-cols-1 sm:grid-cols-2 gap-4 not-prose">
    {left && (
      <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-surface-raised)] p-5">
        <p class={`font-semibold text-lg mb-3 ${leftColor}`}>{left.title}</p>
        <ul class="space-y-2">
          {left.items.map((item) => (
            <li class="text-[var(--color-text-secondary)] text-sm flex items-start gap-2">
              <span class={leftColor}>✗</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
    {right && (
      <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-surface-raised)] p-5">
        <p class={`font-semibold text-lg mb-3 ${rightColor}`}>{right.title}</p>
        <ul class="space-y-2">
          {right.items.map((item) => (
            <li class="text-[var(--color-text-secondary)] text-sm flex items-start gap-2">
              <span class={rightColor}>✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
)}
