---
interface Props {
  stats?: { label: string; value: string }[];
  title?: string;
}

const { stats = [], title } = Astro.props;
const hasStats = stats.length > 0;
---

{hasStats ? (
  <div class="my-8 grid grid-cols-2 sm:grid-cols-3 gap-4 not-prose">
    {stats.map((stat) => (
      <div class="rounded-lg border border-[var(--color-border)] bg-[var(--color-surface-raised)] p-5 text-center">
        <p class="text-2xl sm:text-3xl font-bold text-[var(--color-accent)]">{stat.value}</p>
        <p class="text-sm text-[var(--color-text-muted)] mt-1">{stat.label}</p>
      </div>
    ))}
  </div>
) : (
  <aside class="my-8 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface-raised)] p-5 not-prose">
    {title && <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-[var(--color-accent)]">{title}</p>}
    <div class="text-lg font-semibold leading-relaxed text-[var(--color-text)]">
      <slot />
    </div>
  </aside>
)}
